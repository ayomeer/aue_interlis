-- This setup script was generated by render_sql_template.py in the aue_interlis git repo.
-- 
-- Usage:
-- This script is intended to directly run after importing the corresponding INTERLIS
-- schema and catalogues using ili2pg. It sets up common Postgres-specific functionality 
-- such:
--  - adding last_modified columns and corresponding trigger functionality
--  - setting up priviledges 
--  - adding enum constraints that ili2pg doesn't implement
--  - adding not null constraints (this is a workaround for mandatory catalogue fkey columns
--    not getting materialized with NOT NULL by ili2pg)


-- Drop unused catref tables -----------------------------------------------------------
{%- for catref_table in catref_tables_to_drop %}
DROP TABLE <target_schema>.<catref_table>;
{%- endfor %}

-- Add NOT NULL constraints ------------------------------------------------------------
{%- for constraint in not_null_constraints_to_add %}
ALTER TABLE <target_schema>.<constraint.table>
ALTER COLUMN <constraint.column> SET NOT NULL;
{%- endfor %}


-- Create Domains for custom Enum-Types ------------------------------------------------
{%- for constraint in enum_consraints %}
{%- set domain_name = target_schema ~'.' ~ constraint.table ~ '_' ~ constraint.name -%}
CREATE DOMAIN <domain_name> as TEXT
CHECK (VALUE IN ('< constraint["values"] | join("','") >'));

ALTER TABLE <target_schema>.<constraint.table>
ALTER COLUMN <constraint.column> TYPE <domain_name>;
{%- endfor %}

-- Add last_modified columns ------------------------------------------------------------
{%- for table_name in last_modiefied_table_names %}

-- <table_name>
ALTER TABLE <target_schema>.<table_name>
ADD COLUMN last_modified timestamp without time zone;

CREATE FUNCTION <target_schema>.<table_name>_update()
  RETURNS TRIGGER
  LANGUAGE 'plpgsql'
AS $BODY$

BEGIN
NEW.last_modified = localtimestamp(0);
RETURN NEW;
END;
$BODY$;

ALTER FUNCTION <target_schema>.<table_name>_update()
  OWNER TO <owner>;

CREATE TRIGGER <table_name>_update
  BEFORE UPDATE
  ON <target_schema>.<table_name>
  FOR EACH ROW
  EXECUTE FUNCTION <target_schema>.<table_name>_update();
{%- endfor %}

-- Set up priviledges for schema --------------------------------------------
GRANT USAGE ON SCHEMA <target_schema> TO <targe_schema>_read;

GRANT ALL ON ALL TABLES IN SCHEMA <target_schema> TO <targe_schema>_write
GRANT SELECT ON ALL TABLES IN SCHEMA <target_schema> TO <targe_schema>_read