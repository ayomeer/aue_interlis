INTERLIS 2.3;



MODEL Prod_Quellkataster_V1
  AT "https://dummy.com"
  VERSION "2026-04-07" =

  !! Modelle importieren, in welche später exportiert werden muss
  IMPORTS Grundwasseraustritte_V2_0, GeometryCHLV95_V1, CatalogueObjects_V1;
  IMPORTS Units;

  TOPIC Grundwasseraustritte =
  OID AS INTERLIS.UUIDOID;

    UNIT
      LiterProMinute [lmin] = (Units.L / Units.min);
      Jahr [yrs];

    DOMAIN 
      NumericOK = 0 .. 2999;
      NumericSchachtueberstand = 0 .. 1000 [Units.cm];
  

    /* Individueller Grundwasseraustritt */  
    CLASS Quelle =
      !! --- MGDM Attributen -------------------------------------------------------- !!
      !! (Kopiert von Grundwasseraustritte_V2_0.Grundwasseraustritte.Quelle)

      Identifikator : MANDATORY Grundwasseraustritte_V2_0.IdentifikatorTyp;
      Name : TEXT*255;
      Grundwasserleiter_Typ : MANDATORY (Lockergestein,Kluft,Karst,gemischt,unbestimmt);
      Quelltyp: TEXT*255;
      Fassungsart : MANDATORY (ungefasst,
                               gefasst(
                                 direkt, 
                                 Fassungsstrang, 
                                 Fassungsstollen, 
                                 unbestimmt)
                              );
      Nutzungszustand : Grundwasseraustritte_V2_0.Grundwasseraustritte.Nutzungszustand;
      Trinkwasser : Grundwasseraustritte_V2_0.JaNeinUnbestimmt;
      Zweck : TEXT*255;
      Oeffentliches_Interesse : Grundwasseraustritte_V2_0.JaNeinUnbestimmt;
      Schuettung_minimal: Grundwasseraustritte_V2_0.LiterMinute; !! MANDATORY in MGDM
      Schuettung_mittel:  Grundwasseraustritte_V2_0.LiterMinute; !! MANDATORY in MGDM
      Schuettung_maximal: Grundwasseraustritte_V2_0.LiterMinute; !! MANDATORY in MGDM
      Zustroembereich_erforderlich : Grundwasseraustritte_V2_0.JaNeinUnbestimmt;
      Geometrie : MANDATORY GeometryCHLV95_V1.Coord2;
      Name_WV : TEXT*255;

      !! --- Interen Attributen ----------------------------------------------------- !!
      /* Identifikation */ 
      !! Format: xxxyyy-##. Bezieht sich auf Ablage physischer Quellkataster (Koordinaten inLV03).
      Ordnungs_Nr: TEXT*255; 
    
      !! Format: Manuell vergebene Laufnummer (funktionell Ablagenummer)
      Quellgruppe_Nr: TEXT*31; !! Nur Zahlen (integer) vorgesehen

      /* Position */ 
      Ortschaft: TEXT*255;
      Postleitzahl: TEXT*255;
      Parz_Nr: TEXT*255;
      Hoehe: 0 .. 2999 [INTERLIS.m];
      Lagegenauigkeit: TEXT*255;
      
      /* Fassung */ 
      Schachtueberstand: 0 .. 1000 [Units.cm];
      Fassungsart_beschreibung: TEXT*255;
      Fassungsabdeckung: TEXT*255;
      Fassungszustand: TEXT*255;
      Schachttyp: TEXT*255;
      Anzahl_Zuleitungen: 0..99;
      Schloss: BOOLEAN;
      Fassungseigentuemer: TEXT*255;

      /* Verwendung */ 
      Verwendungsart: TEXT*255;
      Verwendungszweck_beschreibung: TEXT*255;
      Notwasserversorgung: (ja, nein, unbestimmt);

      /* WVA */  
      WVA_Nutzung: BOOLEAN;
      WVA_Nutzung_ergaenzen: BOOLEAN;
      WVA_Nutzung_streichen: BOOLEAN;
      WVA_Nutzung_lage_neu: BOOLEAN; 

      /* Datenherkunft */ 
      Datenherkunft: TEXT*255;
      Aufgenommen_durch: TEXT*255; 
      Erhebungsdatum: INTERLIS.XMLDate;
      Feldbegehung: INTERLIS.XMLDate;
      Objektbereinigung: INTERLIS.XMLDate; 

      /* Fotos */ 
      Foto_Negativ_Nr_1: TEXT*31;
      Foto_Negativ_Nr_2: TEXT*31;
      Foto_Negativ_Nr_3: TEXT*31;

      /* Andere */ 
      Schutzzone: TEXT*255;
      Kontaktperson: TEXT*255;
      Bemerkungen: MTEXT*1023;
      Last_Modified: INTERLIS.XMLDateTime;

    END Quelle; !! End Class

    /* Messungen an Quelle */
    CLASS Messdaten =
      Entnahmedatum: INTERLIS.XMLDate;
      Entnahmezeit: INTERLIS.XMLTime;
      Witterung: TEXT*255;

      Schuettungsmenge: Grundwasseraustritte_V2_0.LiterMinute;
      Wassertemperatur: -100.0 .. 100.0;
      pH_Wert: TEXT*255; !! nur handvoll Werte
      Sauerstoff: TEXT*255; !! keine Werte
      Sauerstoffsaettigung: TEXT*255; !! keine Werte
      Chemische_Analysen: TEXT*255; !! keine Werte
      Bemerkungen: TEXT*255;
      Last_Modified: INTERLIS.XMLDateTime;
    END Messdaten;
    
    /* Informationen zu physischen Ablagen im Landesarchiv */
    CLASS Archiv_Ablage = 
      Archiv_Klasse: TEXT*255;
      Archiv_Band: TEXT*255;
      Archiv_Dossier: TEXT*255;
    END Archiv_Ablage;

    /* Foto von Quelle */
    CLASS Foto = 
      Bezeichnung: TEXT*255;
      Pfad: TEXT;
      
      MANDATORY CONSTRAINT DEFINED(Bezeichnung) OR DEFINED(Pfad);
    END Foto;

    /* Informationen zu zugehöhrigen Konzessionen */
    CLASS Konzession = 
      !! Empfänger
      Vorname_Empfaenger: TEXT;
      Name_Empfaenger: TEXT;
      Strasse_Nr_Empfaenger: TEXT;
      Wohnort_Empfaener: TEXT;

      !! Konzession
      Datum_Amtsblatt: INTERLIS.XMLDate;
      Datum_Start_Laufzeit: INTERLIS.XMLDate;
      Laufzeit: 0 .. 999 [yrs];
      Erteilt_Durch: TEXT*255;

      Entnahme: 0.00 .. 99999.99 [lmin];

      Bemerkungen: MTEXT;
      Last_Modified: INTERLIS.XMLDateTime;

    END Konzession;

    ASSOCIATION QuelleKonzession = 
      von_quelle -- {1..*} Quelle;
      hat_konzession -- {0..*} Konzession;
    END QuelleKonzession;

  
    CLASS Schutzzonen =
      Schutzzonenstatus: TEXT*31; !! Werte in post-schemaimport sql script definiert (constraint)
      Bemerkungen: MTEXT;
      Last_Modified: INTERLIS.XMLDateTime;  
       
    END Schutzzonen;

    ASSOCIATION ArchivFoto = 
      von_archiv -- {0..1} Archiv_Ablage;
      hat_foto -- {0..*} Foto;
    END ArchivFoto;

    ASSOCIATION QuelleFoto = 
      von_quelle -- {1} Quelle;
      hat_foto -- {0..*} Foto;
    END QuelleFoto;


    ASSOCIATION QuelleMessdaten = 
      von_quelle -- {1} Quelle;
      hat_messung -- {0..*} Messdaten;
    END QuelleMessdaten;

    ASSOCIATION QuelleSchutzzonen = 
      von_quelle -- {1..*} Quelle;
      hat_schutzzonen -- {0..1} Schutzzonen;
    END QuelleSchutzzonen;


  END Grundwasseraustritte; !! End Topic
END Prod_Quellkataster_V1. !! End Model