INTERLIS 2.3;


MODEL GL_Bohrkataster_Publikation_V1 (de) 
AT "https://www.gl.ch" 
VERSION "2026-09-14" =
    IMPORTS GeometryCHLV95_V1;
    
    DOMAIN
        X_COORD = 2460000.000 .. 2870000.000 [INTERLIS.m];
        Y_COORD = 1045000.000 .. 1310000.000 [INTERLIS.m];
    
    TOPIC Bohrungen =
        CLASS Grundwasserbohrung = 
            Koordinate_E: X_COORD;
            Koordinate_N: Y_COORD;
            Name: TEXT*255;
            Typ: TEXT*255;
            Pdf: TEXT;
            Geometrie: MANDATORY GeometryCHLV95_V1.Coord2;            
        END Grundwasserbohrung;
    END Bohrungen;

END GL_Bohrkataster_Publikation_V1. 